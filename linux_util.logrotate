__LOG_DIR__/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0600 __USER__ __USER__
    sharedscripts
    postrotate
        # Re-create latest symlinks after rotation
        for f in __LOG_DIR__/success_*.log; do
            [ -f "$f" ] && ln -sf "$(basename "$f")" __LOG_DIR__/success_latest.log && break
        done
        for f in __LOG_DIR__/error_*.log; do
            [ -f "$f" ] && ln -sf "$(basename "$f")" __LOG_DIR__/error_latest.log && break
        done
    endscript
}
