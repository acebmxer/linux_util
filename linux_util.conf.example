# ============================================================================
# Linux Utilities - Configuration File
# Copy this file to linux_util.conf and customize as needed.
# Lines starting with # are comments. Blank lines are ignored.
# ============================================================================

# --- Logging ---
log_retention_days=30
max_log_size_mb=50
max_logs_per_day=15
compress_old_logs=true
# Log level: DEBUG, INFO, WARNING, ERROR
log_level=INFO

# --- Installation ---
# Answer yes to installer confirmation prompts instead of asking (not
# recommended). This applies to prompts the installers raise -- a destructive
# step, or an optional extra such as the tmux shell auto-attach snippet -- not
# to the package manager's own prompts, which are already answered.
# With this false, a run that has no terminal to ask on declines instead.
auto_confirm=false
# Retry failed installations
retry_failed=true
retry_attempts=3

# --- Network ---
dns_check_enabled=true
dns_timeout_seconds=10
# Host used for connectivity check. Override if Cloudflare (1.1.1.1) is blocked
# on your network (e.g., corporate firewalls). A fallback to 9.9.9.9 is always tried.
# dns_check_host=1.1.1.1

# --- Pre-flight ---
# Minimum free disk space in MB before allowing installs
disk_min_mb=1024

# --- Updates ---
# Which stream self-update follows:
#   main     - released versions only (default, recommended)
#   dev      - continuous updates, may be unstable
#   v1.3.1   - pin to that exact release; no updates until you change this
# A manual `git checkout` takes precedence over this setting.
update_channel=main

# --- Behavior ---
auto_cleanup=true

# --- Output ---
# Enable verbose output (extra status messages)
verbose=false
# Enable debug output (internal state, parsed values)
debug=false

# --- Config schema ---
# Records which schema version this file has been brought up to. Written by
# linux_util when it adds keys introduced in a newer release; do not edit.
# Delete this line to force a re-scan for missing keys on the next run.
config_version=1
