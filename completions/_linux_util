_linux_util() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '(- *)'{--help,-h}'[Show usage information and exit]' \
        '(- *)--version[Show script version (git commit)]' \
        '(- *)--list[List all utilities with current install status]' \
        '--dry-run[Preview actions without making any changes]' \
        '--verbose[Enable verbose output]' \
        '--debug[Enable debug output (internal state details)]' \
        '--no-color[Disable coloured output]' \
        '--json[Output machine-readable JSON (use with --list or --check)]' \
        '--update-all[Update every currently installed utility]' \
        '--setup-logrotate[Install logrotate config for linux_util logs]' \
        '--install[Install a utility by name]:utility:->utility' \
        '--uninstall[Uninstall a utility by name]:utility:->utility' \
        '--update[Update a utility by name]:utility:->utility' \
        '--check[Check if a utility is installed]:utility:->utility' \
        '--export-profile[Export a profile utility list to JSON]:profile:->profile_or_file' \
        '--import-profile[Install utilities from an exported profile JSON]:file:_files' \
        && return

    case "$state" in
        utility)
            _describe 'utility' _linux_util_utilities
            ;;
        profile_or_file)
            # First arg after --export-profile may be a profile name or a file
            local profiles=(
                'All Profiles'
                'Run Me First'
                'Default VM Server Profile'
                'Default Physical PC'
                'Developer Workstation'
                'Home Desktop'
            )
            _describe 'profile' profiles || _files
            ;;
    esac
}

_linux_util "$@"
